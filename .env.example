# E10 — sao chép tệp này thành .env rồi điền giá trị thật. KHÔNG commit tệp .env.

# Bắt buộc: chuỗi bí mật ký JWT, tối thiểu 32 ký tự.
JWT_KEY=hay-thay-bang-chuoi-bi-mat-dai-toi-thieu-32-ky-tu

# Tùy chọn: khóa API-Football. Để trống thì hệ thống chạy bằng dữ liệu mẫu.
FOOTBALL_API_KEY=

# Bật đồng bộ định kỳ từ API bóng đá (chỉ bật khi đã có khóa).
FOOTBALL_SYNC=false

# Số cầu thủ tổng cộng sau khi sinh dữ liệu mô phỏng. Đặt 0 để chỉ dùng 149 cầu thủ thật.
SEED_TONG_CAU_THU=2000
