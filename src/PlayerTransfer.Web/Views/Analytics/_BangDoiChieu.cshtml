@model List<PlayerTransfer.Application.Dtos.HangDoiChieuDto>

@if (Model != null && Model.Count > 0)
{
    <table>
        <thead>
        <tr>
            <th>Nhóm</th>
            <th style="text-align:right">Số cầu thủ</th>
            <th style="text-align:right">Giá thật TB</th>
            <th style="text-align:right">Giá mô hình TB</th>
            <th style="text-align:right">Sai số TB</th>
            <th style="text-align:right">Sai số %</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var h in Model)
        {
            <tr>
                <td>@h.Nhan</td>
                <td style="text-align:right">@DinhDangSo.So(h.SoCauThu)</td>
                <td style="text-align:right">@DinhDangSo.So(h.GiaThatTrungBinh, 1)</td>
                <td style="text-align:right">@DinhDangSo.So(h.GiaDuDoanTrungBinh, 1)</td>
                <td style="text-align:right">@DinhDangSo.So(h.SaiSoTuyetDoiTrungBinh, 1)</td>
                <td style="text-align:right;font-weight:600">@DinhDangSo.So(h.SaiSoPhanTramTrungBinh, 1)%</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p class="mo">Không có dữ liệu.</p>
}
