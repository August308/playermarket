@model List<PlayerTransfer.Application.Dtos.ThuongVuDto>

@if (Model == null || Model.Count == 0)
{
    <p class="mo">Không có thương vụ nào.</p>
}
else
{
    <table>
        <thead>
        <tr><th>Cầu thủ</th><th>Mùa</th><th style="text-align:right">Phí</th></tr>
        </thead>
        <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>
                    <a asp-controller="Players" asp-action="ChiTiet" asp-route-id="@t.MaCauThu">@t.CauThu</a>
                    <div class="mo" style="font-size:.78rem">@(t.CLBDi ?? "—") → @(t.CLBDen ?? "—")</div>
                </td>
                <td class="mo">@t.MuaGiai</td>
                <td style="text-align:right;font-weight:600">@DinhDangSo.TrieuEuro(t.PhiChuyenNhuong)</td>
            </tr>
        }
        </tbody>
    </table>
}
