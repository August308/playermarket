@{ ViewData["Title"] = "Đặt lại mật khẩu"; }

<div class="khoi form-khung">
    <h1 style="margin-bottom:6px">Đặt lại mật khẩu</h1>
    <p class="phu" style="margin-top:0">Mật khẩu mới cần tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và số.</p>

    <form method="post" asp-controller="Account" asp-action="DatLaiMatKhau">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ma" value="@ViewBag.Ma" />

        <div asp-validation-summary="ModelOnly" class="bao bao-loi"
             style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

        <div class="truong">
            <label>Mật khẩu mới</label>
            <input class="o-nhap" type="password" name="matKhauMoi" required minlength="8" />
        </div>
        <div class="truong">
            <label>Nhập lại mật khẩu mới</label>
            <input class="o-nhap" type="password" name="nhapLai" required minlength="8" />
        </div>

        <button type="submit" class="nut nut-chinh" style="width:100%">Cập nhật mật khẩu</button>
    </form>
</div>
